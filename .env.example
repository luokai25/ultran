# Local runtime configuration. Copy to .env and fill in.

# agent-core loopback listener
ULTRAN_PORT=7700
ULTRAN_AGENT_CORE_URL=http://127.0.0.1:7700

# Cloud control plane (optional - leave blank for local-only mode)
ULTRAN_API_URL=
DATABASE_URL=

# Billing (server-side only; never expose to clients)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
