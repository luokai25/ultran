apps/phone/android/*.keystore
apps/phone/android/*.jks
apps/phone/android/keystore.properties
apps/phone/android/app/build/
apps/phone/android/build/
apps/phone/android/.gradle/
apps/phone/android/local.properties
apps/phone/android/app/src/main/assets/public/

# Generated Android raster assets - produced by apps/phone/android/tools/generate_assets.py
apps/phone/android/app/src/main/res/mipmap-*/ic_launcher*.png
apps/phone/android/app/src/main/res/drawable*/splash.png
