{
  "expo": {
    "name": "Ultron",
    "slug": "ultron",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ultron",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b0d10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ultron.mobile"
    },
    "android": {
      "package": "app.ultron.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d10"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}