{
  "name": "@ultron/phone",
  "version": "3.0.0",
  "private": true,
  "description": "Ultron phone client - the Capacitor shell that ships the signed Android APK.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "node test/shell-lint.test.mjs",
    "test": "node --test test/*.test.mjs",
    "clean": "rm -rf dist android/app/src/main/assets/public",
    "cap:sync": "cap sync android",
    "android:release": "cd android && ./gradlew assembleRelease --no-daemon --console=plain"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/browser": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@ultron/connectors": "workspace:*",
    "mammoth": "1.9.1",
    "pdfjs-dist": "4.10.38",
    "three": "^0.169.0",
    "@supabase/supabase-js": "^2.57.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.10"
  }
}
