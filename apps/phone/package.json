{
  "name": "@ultran/phone",
  "version": "0.2.0",
  "private": true,
  "description": "Ultran phone client - the Capacitor shell that ships the signed Android APK.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "echo lint pending",
    "test": "echo no tests yet",
    "clean": "rm -rf dist android/app/src/main/assets/public",
    "cap:sync": "cap sync android",
    "android:release": "cd android && ./gradlew assembleRelease --no-daemon --console=plain"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.10"
  }
}
