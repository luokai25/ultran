# Copy to .env and chmod 600 .env. Never commit the real .env.
ULTRAN_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# Generate once on the server with Python's standard library:
# python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Back this up securely. Losing it makes saved provider credentials unrecoverable.
ULTRAN_CREDENTIAL_ENCRYPTION_KEY=

# Exact web origins allowed to call the API, comma-separated.
ULTRAN_CORS_ORIGINS=https://app.example.com

# Composio OAuth gateway key. Keep this ONLY in the backend .env (chmod 600).
# Never put it in the Android app, frontend variables, or a committed .env file.
ULTRAN_COMPOSIO_API_KEY=
# Optional OAuth callback URL if your Composio project requires a fixed callback.
ULTRAN_COMPOSIO_CALLBACK_URL=

# Start with hosted provider APIs; do not bind a model server to the public interface.
ULTRAN_BRAIN_BACKEND=echo
ULTRAN_BRAIN_FALLBACKS=echo
ULTRAN_BRAIN_TIMEOUT_S=30
