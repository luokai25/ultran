{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultran.dev/schemas/connector-manifest.json",
  "title": "Ultran Connector Manifest",
  "description": "A connector's declaration of capabilities, authentication, egress, and tools.",
  "type": "object",
  "required": ["id", "version", "displayName", "capabilities", "auth", "egress", "tools"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Lowercase connector identifier; also the tool-id namespace."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "Semantic version."
    },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$" }
    },
    "auth": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["oauth2", "pat", "none", "mtls"] },
        "scopes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "egress": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "port"],
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+$",
            "description": "Exact hostname. Wildcards are forbidden."
          },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "capability", "inputSchema"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "capability": { "type": "string" },
          "inputSchema": { "type": "object" },
          "network": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
