# Ultran backend runtime configuration
ULTRAN_ENV=dev
ULTRAN_API_PREFIX=/v1
ULTRAN_DATA_DIR=.ultran-data

# REQUIRED for production. Generate a private key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store it in your host secret manager. Never commit the generated value.
ULTRAN_CREDENTIAL_ENCRYPTION_KEY=

# Local AI brain: "echo" (offline deterministic), "ollama", or "openai"
# ("openai" = any self-hosted OpenAI-compatible server: llama.cpp, LM Studio, vLLM)
ULTRAN_BRAIN_BACKEND=echo
ULTRAN_BRAIN_ENDPOINT=http://127.0.0.1:11434
ULTRAN_BRAIN_MODEL=llama3.1:8b
ULTRAN_BRAIN_TIMEOUT_S=30
# Self-hosted OpenAI-compatible endpoint (used when backend/fallback is "openai")
ULTRAN_BRAIN_OPENAI_ENDPOINT=http://127.0.0.1:1234
# Failover chain tried after the primary, e.g. "openai,echo". Echo is always the
# last-resort floor, so the brain keeps answering with every runtime down.
ULTRAN_BRAIN_FALLBACKS=
ULTRAN_BRAIN_RETRIES=1
ULTRAN_BRAIN_BREAKER_THRESHOLD=3
ULTRAN_BRAIN_BREAKER_COOLDOWN_S=30

# Tool sandbox budgets
ULTRAN_SANDBOX_MAX_TTL_S=900
ULTRAN_SANDBOX_CPU_MS_BUDGET=2000

# Free tier allowance (tokens per month)
ULTRAN_FREE_PLAN_MONTHLY_TOKENS=100000

# Composio hosted OAuth + MCP connector gateway
# Create a free project at https://platform.composio.dev and keep this key server-side.
# Never put the key in the Android app, a public .env file, or Git.
ULTRAN_COMPOSIO_API_KEY=
# Optional: where Composio sends the user after a successful connection.
ULTRAN_COMPOSIO_CALLBACK_URL=
