# Ultron backend runtime configuration
ULTRON_ENV=dev
ULTRON_API_PREFIX=/v1
ULTRON_DATA_DIR=.ultron-data

# REQUIRED for production. Generate a private key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store it in your host secret manager. Never commit the generated value.
ULTRON_CREDENTIAL_ENCRYPTION_KEY=

# Local AI brain: "echo" (offline deterministic) or "openai" (an OpenAI-compatible
# endpoint such as llama.cpp server, LM Studio, vLLM, or a hosted provider).
ULTRON_BRAIN_BACKEND=echo
ULTRON_BRAIN_MODEL=default
ULTRON_BRAIN_TIMEOUT_S=30
# Self-hosted OpenAI-compatible endpoint (used when backend/fallback is "openai")
ULTRON_BRAIN_OPENAI_ENDPOINT=http://127.0.0.1:1234
# Failover chain tried after the primary, e.g. "openai,echo". Echo is always the
# last-resort floor, so the brain keeps answering with every runtime down.
ULTRON_BRAIN_FALLBACKS=
ULTRON_BRAIN_RETRIES=1
ULTRON_BRAIN_BREAKER_THRESHOLD=3
ULTRON_BRAIN_BREAKER_COOLDOWN_S=30

# Tool sandbox budgets
ULTRON_SANDBOX_MAX_TTL_S=900
ULTRON_SANDBOX_CPU_MS_BUDGET=2000

# Free tier allowance (tokens per month)
ULTRON_FREE_PLAN_MONTHLY_TOKENS=100000

# Composio hosted OAuth + MCP connector gateway
# Create a free project at https://platform.composio.dev and keep this key server-side.
# Never put the key in the Android app, a public .env file, or Git.
ULTRON_COMPOSIO_API_KEY=
# Optional: where Composio sends the user after a successful connection.
ULTRON_COMPOSIO_CALLBACK_URL=
